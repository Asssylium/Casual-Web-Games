{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    },
    "api/socket-io.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/index?route=auth/:path*"
    }
  ]
}